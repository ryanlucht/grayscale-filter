{
  "name": "grayscale-filter-extension",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Chrome extension for effortless grayscale website control",
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=tests/unit",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=tests/e2e --runInBand",
    "test:all": "npm run test && npm run test:e2e",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --testPathPatterns=tests/unit",
    "lint": "eslint .",
    "package:extension": "bash scripts/package-extension.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "puppeteer": "^25.10.0"
  }
}
